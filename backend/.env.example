PORT=3000
MONGODB_URI=mongodb://localhost:27017/fitai
JWT_SECRET=replace_with_a_long_random_string   # e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_REFRESH_SECRET=replace_with_another_long_random_string
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
ML_SERVICE_URL=http://localhost:8001

# AI Coach provider — most requests are resolved locally (no external call at all).
# Only ambiguous requests escalate to whichever provider is set here.
# AI_PROVIDER=none disables external LLM calls entirely (fully local operation).
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
